# Internal business-rule check (auvoerechnung_rules.php) — the rule code is prepended
AuvoERechnungXsdEmpty = Empty XML
AuvoERechnungXsdMalformed = Malformed XML: %s
AuvoERechnungXsdInvalid = not compliant with the EN16931 XSD: %s
AuvoERechnungRulePartySeller = seller
AuvoERechnungRulePartyBuyer = buyer
AuvoERechnungRuleBR16 = The invoice must contain at least one line
AuvoERechnungRuleBR27 = line %s — the net unit price must not be negative (%s)
AuvoERechnungRuleS05 = line %s — category S with a zero rate
AuvoERechnungRuleCat05 = line %s — category %s with a non-zero rate (%s)
AuvoERechnungRuleCO10 = LineTotalAmount (%s) != sum of lines (%s)
AuvoERechnungRuleCO11 = AllowanceTotalAmount (%s) != sum of allowances (%s)
AuvoERechnungRuleCO12 = ChargeTotalAmount (%s) != sum of charges (%s)
AuvoERechnungRuleCO13 = TaxBasisTotalAmount (%s) != lines - allowances + charges (%s)
AuvoERechnungRuleCO15 = GrandTotalAmount (%s) != tax basis (%s) + VAT (%s)
AuvoERechnungRuleCO16 = DuePayableAmount (%s) != GrandTotal (%s) - Prepaid (%s)
AuvoERechnungRuleCO17 = calculated VAT (%s) != basis (%s) x rate (%s %%) = %s
AuvoERechnungRuleCat08 = basis of category %s at %s %% (%s) != sum of lines/allowances (%s)
AuvoERechnungRuleCat10 = exemption reason missing for category %s
AuvoERechnungRuleCO14 = TaxTotalAmount (%s) != sum of VAT per category (%s)
AuvoERechnungRuleBR61 = payment means %s (credit transfer) without payee IBAN
AuvoERechnungRuleIC11 = category K without delivery date or invoicing period
AuvoERechnungRuleIC12 = category K without deliver-to country (BT-80)
AuvoERechnungRuleIC02 = category K without seller VAT identifier (BT-31)
AuvoERechnungRuleAE02 = category AE — seller (BT-31) and buyer (BT-48) VAT identifiers are mandatory
AuvoERechnungRuleCO09 = VAT ID "%s" does not start with a country code
AuvoERechnungRuleCO26 = the seller must carry a legal registration identifier (BT-30) or a tax identifier (BT-31/BT-32)
AuvoERechnungRuleBR09 = seller address country missing (BT-40)
AuvoERechnungRuleBR11 = buyer address country missing (BT-55)
AuvoERechnungRuleCO25 = positive amount due without payment due date (BT-9) or payment terms (BT-20)
AuvoERechnungRuleFR01 = invoice number (BT-1) limited to 35 characters (%s issued)
AuvoERechnungRuleFR02 = invoice number (BT-1) "%s" — only alphanumerics and - + _ / are allowed (no spaces)
AuvoERechnungRuleFR04 = document type (BT-3) "%s" is not in the closed list allowed in France
AuvoERechnungRuleFR09Length = the %s SIRET must have 14 digits (%s)
AuvoERechnungRuleFR09Mismatch = %s SIRET (%s) inconsistent with its SIREN (%s) — the first 9 digits must match
AuvoERechnungRuleFRCO04Count = corrective invoice (%s) — exactly one reference to the preceding invoice (BT-25) is required (%s issued)
AuvoERechnungRuleFRCO04Date = corrective invoice (%s) — the preceding invoice date (BT-26) is required
AuvoERechnungRuleFRCO05Missing = credit note (%s) — at least one reference to the preceding invoice (BT-25) is required (create the credit note from the original invoice)
AuvoERechnungRuleFRCO05Date = credit note (%s) — the preceding invoice date (BT-26) is required on the reference
AuvoERechnungRuleFR23 = electronic address 0225 "%s" — only alphanumerics and - _ . are allowed

