DoliZugferdPdfFontDefault = — Dolibarr default font (no forcing) —
DoliZugferdPdfFontOk = ✓ Factur-X compliant (embedded)
DoliZugferdPdfFontKo = ⚠ not PDF/A-3 compliant (not embedded)

# Internal business-rule check (dolizugferd_rules.php) — the rule code is prepended
DoliZugferdXsdEmpty = Empty XML
DoliZugferdXsdMalformed = Malformed XML: %s
DoliZugferdXsdInvalid = not compliant with the EN16931 XSD: %s
DoliZugferdRulePartySeller = seller
DoliZugferdRulePartyBuyer = buyer
DoliZugferdRuleBR16 = The invoice must contain at least one line
DoliZugferdRuleBR27 = line %s — the net unit price must not be negative (%s)
DoliZugferdRuleS05 = line %s — category S with a zero rate
DoliZugferdRuleCat05 = line %s — category %s with a non-zero rate (%s)
DoliZugferdRuleCO10 = LineTotalAmount (%s) != sum of lines (%s)
DoliZugferdRuleCO11 = AllowanceTotalAmount (%s) != sum of allowances (%s)
DoliZugferdRuleCO12 = ChargeTotalAmount (%s) != sum of charges (%s)
DoliZugferdRuleCO13 = TaxBasisTotalAmount (%s) != lines - allowances + charges (%s)
DoliZugferdRuleCO15 = GrandTotalAmount (%s) != tax basis (%s) + VAT (%s)
DoliZugferdRuleCO16 = DuePayableAmount (%s) != GrandTotal (%s) - Prepaid (%s)
DoliZugferdRuleCO17 = calculated VAT (%s) != basis (%s) x rate (%s %%) = %s
DoliZugferdRuleCat08 = basis of category %s at %s %% (%s) != sum of lines/allowances (%s)
DoliZugferdRuleCat10 = exemption reason missing for category %s
DoliZugferdRuleCO14 = TaxTotalAmount (%s) != sum of VAT per category (%s)
DoliZugferdRuleBR61 = payment means %s (credit transfer) without payee IBAN
DoliZugferdRuleIC11 = category K without delivery date or invoicing period
DoliZugferdRuleIC12 = category K without deliver-to country (BT-80)
DoliZugferdRuleIC02 = category K without seller VAT identifier (BT-31)
DoliZugferdRuleAE02 = category AE — seller (BT-31) and buyer (BT-48) VAT identifiers are mandatory
DoliZugferdRuleCO09 = VAT ID "%s" does not start with a country code
DoliZugferdRuleCO26 = the seller must carry a legal registration identifier (BT-30) or a tax identifier (BT-31/BT-32)
DoliZugferdRuleBR09 = seller address country missing (BT-40)
DoliZugferdRuleBR11 = buyer address country missing (BT-55)
DoliZugferdRuleCO25 = positive amount due without payment due date (BT-9) or payment terms (BT-20)
DoliZugferdRuleFR01 = invoice number (BT-1) limited to 35 characters (%s issued)
DoliZugferdRuleFR02 = invoice number (BT-1) "%s" — only alphanumerics and - + _ / are allowed (no spaces)
DoliZugferdRuleFR04 = document type (BT-3) "%s" is not in the closed list allowed in France
DoliZugferdRuleFR09Length = the %s SIRET must have 14 digits (%s)
DoliZugferdRuleFR09Mismatch = %s SIRET (%s) inconsistent with its SIREN (%s) — the first 9 digits must match
DoliZugferdRuleFRCO04Count = corrective invoice (%s) — exactly one reference to the preceding invoice (BT-25) is required (%s issued)
DoliZugferdRuleFRCO04Date = corrective invoice (%s) — the preceding invoice date (BT-26) is required
DoliZugferdRuleFRCO05Missing = credit note (%s) — at least one reference to the preceding invoice (BT-25) is required (create the credit note from the original invoice)
DoliZugferdRuleFRCO05Date = credit note (%s) — the preceding invoice date (BT-26) is required on the reference
DoliZugferdRuleFR23 = electronic address 0225 "%s" — only alphanumerics and - _ . are allowed

# Errors while embedding the XML into the PDF
DoliZugferdErrInjReadSource = unable to read the source files (PDF/XML)
DoliZugferdErrInjLibMissing = embedding library not found (vendor/ missing?)
DoliZugferdErrInjEmptyOutput = embedding returned an empty output
DoliZugferdErrInjWriteOutput = unable to write the output PDF
DoliZugferdErrInjReplacePdf = unable to replace the original PDF
DoliZugferdErrInjNoPhpCli = PHP CLI binary not found
DoliZugferdErrInjFpdiConflict = %s already loaded outside the module vendor (%s): FPDI conflict, in-process embedding impossible
